# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=hpbs_user
DATABASE_PASSWORD=hpbs_password
DATABASE_NAME=hpbs_pkh
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=your-access-secret-key-replace-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-replace-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# For production, use RS256 with key files:
# JWT_PRIVATE_KEY_PATH=/path/to/private.pem
# JWT_PUBLIC_KEY_PATH=/path/to/public.pem

# S3 Storage (AWS S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=hpbs-pkh
S3_FORCE_PATH_STYLE=true

# SMTP / Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@hpbs.com
SMTP_FROM_NAME=HPBS PKH

# AI Voice API (Client-provided)
AI_VOICE_API_URL=https://api.example.com/voice
AI_VOICE_API_KEY=your-ai-voice-api-key

# Heygen
HEYGEN_API_URL=https://api.heygen.com
HEYGEN_API_KEY=your-heygen-api-key

# Security
BCRYPT_ROUNDS=12
PASSWORD_RESET_TOKEN_EXPIRATION=1h
UPLOAD_PRESIGNED_URL_EXPIRATION=300
DOWNLOAD_PRESIGNED_URL_EXPIRATION=3600

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=5
THROTTLE_AI_LIMIT=10

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Observability
LOG_LEVEL=info
LOG_PRETTY=true

# Feature Flags
FEATURE_AI_VOICE_ENABLED=true
FEATURE_VIDEO_PROGRESS_TRACKING=true
FEATURE_ANALYTICS_ENABLED=true

# Virus Scanning (ClamAV)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310